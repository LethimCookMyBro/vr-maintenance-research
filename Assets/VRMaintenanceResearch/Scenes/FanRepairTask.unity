TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1331395155}
  m_Text: 'Fan Troubleshooting Guide


    Disconnect power before opening the guard.
    Trace the power cord to the fuse holder, identify the working replacement fuse,
    install it, then use the speed control for the neutral device test.'
